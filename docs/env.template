# ============================================================
# TalentLink Campus — Template Environment Variables
# ============================================================
# CARA PAKAI:
#   - Development lokal  : salin file ini ke ".env.local" lalu isi nilainya
#   - Vercel (production): salin setiap baris ke Settings → Environment Variables
#
# JANGAN pernah commit file .env.local atau nilai asli ke repo.
# ============================================================


# ------------------------------------------------------------
# CBN API — Wajib diisi agar pipeline LLM bisa berjalan
# Dapatkan dari panitia kompetisi.
# ------------------------------------------------------------

# URL gateway dari panitia. Harus diakhiri /v1
CBN_API_BASE_URL=https://litellm-hackathon.digdaya.ai/v1

# API key dari panitia. Tandai "Sensitive" di Vercel.
CBN_API_KEY=GANTI_DENGAN_API_KEY_DARI_PANITIA

# Model untuk parsing brief (sesuaikan dengan daftar model resmi panitia)
CBN_MODEL_PARSE=qwen3.8-flash

# Model untuk penjelasan/explain
CBN_MODEL_EXPLAIN=qwen3.7-plus


# ------------------------------------------------------------
# Anggaran Token (Token Ledger & Budget Guard)
# Sesuaikan jika panitia memberi kuota berbeda.
# ------------------------------------------------------------

# Total batas token yang boleh dipakai
TOKEN_BUDGET_TOTAL=10000000

# Proporsi penggunaan untuk memicu peringatan (0.0 - 1.0)
TOKEN_BUDGET_WARN=0.8

# Proporsi penggunaan untuk menghentikan request baru (0.0 - 1.0)
TOKEN_BUDGET_STOP=0.95


# ------------------------------------------------------------
# Database — Development lokal (tanpa Turso)
# Kosongkan TURSO_* agar aplikasi memakai file SQLite lokal.
# ------------------------------------------------------------

# Path ke file SQLite lokal (relatif terhadap root project)
# Hanya dipakai jika TURSO_DATABASE_URL kosong.
DATABASE_PATH=data/talentlink.db


# ------------------------------------------------------------
# Database — Turso (Production / Vercel)
# JANGAN diketik ulang di repo. Diisi otomatis oleh integrasi
# Turso di Vercel Marketplace, atau isi manual saat seed lokal.
# ------------------------------------------------------------

TURSO_DATABASE_URL=libsql://GANTI_DENGAN_URL_DARI_DASHBOARD_TURSO
TURSO_AUTH_TOKEN=GANTI_DENGAN_TOKEN_DARI_DASHBOARD_TURSO


# ------------------------------------------------------------
# Akun Demo
# Wajib diubah sebelum deploy publik (lihat bagian 2 panduan).
# Jangan gunakan "talentlink2026" lagi!
# ------------------------------------------------------------

DEMO_PASSWORD=GANTI_DENGAN_KATA_SANDI_BARU_YANG_KUAT


# ------------------------------------------------------------
# Mode Mock LLM
# Gunakan "true" hanya untuk Preview deployment tanpa kuota token.
# Set "false" (atau hapus) untuk Production.
# ------------------------------------------------------------

LLM_MOCK=false


# ------------------------------------------------------------
# PERHATIAN — Variabel berikut TIDAK boleh dipakai di Vercel
# ------------------------------------------------------------

# JANGAN set ini ke "true" saat build production.
# Variabel NEXT_PUBLIC_* ditanam saat build; jika true,
# frontend akan menampilkan data contoh, bukan data asli.
#
# NEXT_PUBLIC_API_MOCK=false
