# API CBN (gateway LiteLLM, kompatibel OpenAI). Salin ke .env lalu isi key.
CBN_API_BASE_URL=https://litellm-hackathon.digdaya.ai/v1
CBN_API_KEY=               # jangan di-commit
CBN_MODEL_PARSE=qwen3.8-flash        # model ringan untuk parsing JSON
CBN_MODEL_EXPLAIN=qwen3.7-plus       # model lebih kuat untuk penjelasan
TOKEN_BUDGET_TOTAL=10000000
TOKEN_BUDGET_WARN=0.8
TOKEN_BUDGET_STOP=0.95
LLM_MOCK=false             # true hanya untuk pengembangan UI dan unit test
DATABASE_PATH=data/talentlink.db
